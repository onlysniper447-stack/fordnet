# Zcash node JSON-RPC (zcashd or Zebra). Server-side only — never prefix with NEXT_PUBLIC_.
# Leave ZCASH_RPC_URL empty to run against the built-in MOCKED RPC client (UI shows a MOCKED banner).
ZCASH_RPC_URL=
ZCASH_RPC_USER=
ZCASH_RPC_PASS=
# Force mock even if a URL is set
ZCASH_MOCK=0
# Neon Postgres (set by the Vercel Neon integration). Tables are auto-created on first use;
# `pnpm db:push` applies src/db/schema.ts with drizzle-kit (uses DATABASE_URL_UNPOOLED if set).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# HMAC secret embedded in API keys so they verify on every serverless instance. Use a long random value.
KEY_SIGNING_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/ingest
CRON_SECRET=
